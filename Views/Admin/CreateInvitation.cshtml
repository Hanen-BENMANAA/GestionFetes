@model Invitation
@{
    ViewData["Title"] = "Nouvelle Invitation";
}

<div class="mb-4">
    <a asp-action="Invitations" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Retour
    </a>
</div>
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark fw-bold">
                <i class="fas fa-envelope-open me-2"></i>Créer une invitation
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateInvitation" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="IdFete" class="form-label fw-semibold">Fête</label>
                        <select asp-for="IdFete" asp-items="ViewBag.Fetes" class="form-select">
                            <option value="">-- Choisir une fête --</option>
                        </select>
                        <span asp-validation-for="IdFete" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="IdInvite" class="form-label fw-semibold">Invité</label>
                        <select asp-for="IdInvite" asp-items="ViewBag.Invites" class="form-select">
                            <option value="">-- Choisir un invité --</option>
                        </select>
                        <span asp-validation-for="IdInvite" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning text-dark flex-fill">
                            <i class="fas fa-paper-plane me-2"></i>Envoyer l'invitation
                        </button>
                        <a asp-action="Invitations" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
