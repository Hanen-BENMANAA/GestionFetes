@model Salle
@{
    ViewData["Title"] = "Modifier la Salle";
}

<div class="mb-4">
    <a asp-action="Salles" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Retour
    </a>
</div>
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark fw-bold">
                <i class="fas fa-edit me-2"></i>Modifier la salle #@Model.IdSalle
            </div>
            <div class="card-body p-4">
                <form asp-action="EditSalle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdSalle" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="NomSalle" class="form-label fw-semibold"></label>
                        <input asp-for="NomSalle" class="form-control" />
                        <span asp-validation-for="NomSalle" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AddresseSalle" class="form-label fw-semibold"></label>
                        <input asp-for="AddresseSalle" class="form-control" />
                        <span asp-validation-for="AddresseSalle" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="Capacite" class="form-label fw-semibold"></label>
                            <input asp-for="Capacite" class="form-control" type="number" min="1" />
                            <span asp-validation-for="Capacite" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="PrixParHeure" class="form-label fw-semibold"></label>
                            <input asp-for="PrixParHeure" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="PrixParHeure" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning text-dark flex-fill">
                            <i class="fas fa-save me-2"></i>Enregistrer
                        </button>
                        <a asp-action="Salles" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
