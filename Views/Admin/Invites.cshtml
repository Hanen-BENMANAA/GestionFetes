@model IEnumerable<Invite>
@{
    ViewData["Title"] = "Gestion des Invités";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fas fa-users me-2 text-success"></i>Gestion des Invités</h2>
        <p class="text-muted mb-0">@Model.Count() invité(s) enregistré(s)</p>
    </div>
    <a asp-action="CreateInvite" class="btn btn-success">
        <i class="fas fa-plus me-2"></i>Nouvel Invité
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Nom Complet</th>
                        <th>Date Naissance</th>
                        <th>Adresse</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invite in Model)
                    {
                        <tr>
                            <td class="text-muted">#@invite.IdInvite</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-success text-white rounded-circle d-flex align-items-center justify-content-center me-2"
                                         style="width:38px;height:38px;font-weight:bold;">
                                        @invite.Prenom.FirstOrDefault()@invite.Nom.FirstOrDefault()
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@invite.NomComplet</div>
                                        <div class="small text-muted">@invite.Age ans</div>
                                    </div>
                                </div>
                            </td>
                            <td>@invite.DateNaissance.ToString("dd/MM/yyyy")</td>
                            <td class="text-muted small">@invite.AdresseInvite</td>
                            <td>
                                @if (!string.IsNullOrEmpty(invite.Email))
                                {
                                    <a href="mailto:@invite.Email" class="text-decoration-none small">@invite.Email</a>
                                }
                                else { <span class="text-muted">-</span> }
                            </td>
                            <td class="small">@(invite.Telephone ?? "-")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="EditInvite" asp-route-id="@invite.IdInvite"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="DeleteInvite" asp-route-id="@invite.IdInvite" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Supprimer cet invité ?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
