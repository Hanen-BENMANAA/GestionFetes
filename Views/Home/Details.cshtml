@model Fete
@{
    ViewData["Title"] = "Détails de la fête";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fas fa-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h3 class="fw-bold">@Model.Description</h3>
                    <span class="badge bg-primary fs-6 px-3 py-2">@Model.Type</span>
                </div>

                <div class="row g-3 mt-2">
                    <div class="col-sm-6">
                        <div class="info-box p-3 bg-light rounded-3">
                            <div class="text-muted small">Date de la fête</div>
                            <div class="fw-semibold">
                                <i class="fas fa-calendar-alt text-primary me-1"></i>
                                @Model.DateFete.ToString("dddd dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
                            </div>
                            <div class="text-muted small">@Model.DateFete.ToString("HH:mm")</div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-box p-3 bg-light rounded-3">
                            <div class="text-muted small">Durée</div>
                            <div class="fw-semibold">
                                <i class="fas fa-clock text-success me-1"></i>@Model.Duree heures
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-box p-3 bg-light rounded-3">
                            <div class="text-muted small">Nombre max d'invités</div>
                            <div class="fw-semibold">
                                <i class="fas fa-users text-warning me-1"></i>@Model.NbInvitesMax personnes
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="info-box p-3 bg-light rounded-3">
                            <div class="text-muted small">Invités confirmés</div>
                            <div class="fw-semibold">
                                <i class="fas fa-check-circle text-success me-1"></i>@Model.NbInvitesConfirmes / @Model.NbInvitesMax
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.Invitations.Any())
                {
                    <h5 class="fw-bold mt-4 mb-3">
                        <i class="fas fa-envelope-open me-2 text-primary"></i>Liste des invités
                    </h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Invité</th>
                                    <th>Date d'invitation</th>
                                    <th>Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inv in Model.Invitations)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width:35px;height:35px;font-size:14px;">
                                                    @inv.Invite?.Prenom.FirstOrDefault()@inv.Invite?.Nom.FirstOrDefault()
                                                </div>
                                                @inv.Invite?.NomComplet
                                            </div>
                                        </td>
                                        <td class="text-muted small">@inv.DateInvitation.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (inv.ConfirmeInvitation)
                                            {
                                                <span class="badge bg-success"><i class="fas fa-check me-1"></i>Confirmée</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>En attente</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        @if (Model.Salle != null)
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-info text-white fw-bold">
                    <i class="fas fa-building me-2"></i>Salle
                </div>
                <div class="card-body">
                    <h5 class="fw-bold">@Model.Salle.NomSalle</h5>
                    <p class="text-muted mb-2">
                        <i class="fas fa-map-marker-alt me-2 text-danger"></i>@Model.Salle.AddresseSalle
                    </p>
                    <p class="mb-2">
                        <i class="fas fa-users me-2 text-primary"></i>Capacité : <strong>@Model.Salle.Capacite</strong> pers.
                    </p>
                    <p class="mb-0">
                        <i class="fas fa-money-bill me-2 text-success"></i>@Model.Salle.PrixParHeure DT/h
                    </p>
                </div>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white fw-bold">
                <i class="fas fa-calculator me-2"></i>Estimation
            </div>
            <div class="card-body">
                <p class="mb-2">Durée : <strong>@Model.Duree h</strong></p>
                <p class="mb-2">Prix/heure : <strong>@(Model.Salle?.PrixParHeure ?? 0) DT</strong></p>
                <hr />
                <p class="fw-bold text-success fs-5 mb-0">
                    Coût total : @Model.CoutTotal.ToString("N2") DT
                </p>
            </div>
        </div>
    </div>
</div>
