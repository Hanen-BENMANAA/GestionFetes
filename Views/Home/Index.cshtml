@model IEnumerable<Fete>
@{
    ViewData["Title"] = "Les Fêtes Disponibles";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="fas fa-champagne-glasses me-2 text-primary"></i>Fêtes Disponibles</h2>
        <p class="text-muted mb-0">Découvrez toutes les fêtes et confirmez vos invitations</p>
    </div>
    <a asp-action="Search" class="btn btn-outline-primary">
        <i class="fas fa-search me-2"></i>Rechercher
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-calendar-times text-muted" style="font-size: 4rem;"></i>
        <h4 class="mt-3 text-muted">Aucune fête disponible</h4>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var fete in Model)
        {
            var badgeClass = fete.Type switch {
                TypeFete.Anniversaire => "badge-anniversaire",
                TypeFete.Mariage => "badge-mariage",
                _ => "badge-autre"
            };
            var icon = fete.Type switch {
                TypeFete.Anniversaire => "fa-birthday-cake",
                TypeFete.Mariage => "fa-rings-wedding",
                _ => "fa-star"
            };
            var cardColor = fete.Type switch {
                TypeFete.Anniversaire => "card-anniversaire",
                TypeFete.Mariage => "card-mariage",
                _ => "card-autre"
            };
            var isPast = fete.DateFete < DateTime.Now;
            <div class="col-lg-4 col-md-6">
                <div class="card fete-card h-100 shadow-sm border-0 @cardColor @(isPast ? "opacity-75" : "")">
                    <div class="card-header-custom d-flex justify-content-between align-items-center p-3">
                        <span class="badge @badgeClass fs-6 px-3 py-2">
                            <i class="fas @icon me-1"></i>@fete.Type
                        </span>
                        @if (isPast)
                        {
                            <span class="badge bg-secondary">Passée</span>
                        }
                        else if (fete.DateFete <= DateTime.Now.AddDays(7))
                        {
                            <span class="badge bg-warning text-dark">Bientôt !</span>
                        }
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@fete.Description</h5>
                        <div class="fete-details mt-3">
                            <div class="detail-item">
                                <i class="fas fa-calendar-alt text-primary me-2"></i>
                                <span>@fete.DateFete.ToString("dddd dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</span>
                            </div>
                            <div class="detail-item mt-2">
                                <i class="fas fa-clock text-success me-2"></i>
                                <span>@fete.DateFete.ToString("HH:mm") - Durée : @fete.Duree h</span>
                            </div>
                            <div class="detail-item mt-2">
                                <i class="fas fa-building text-info me-2"></i>
                                <span>@(fete.Salle?.NomSalle ?? "N/A")</span>
                            </div>
                            <div class="detail-item mt-2">
                                <i class="fas fa-users text-warning me-2"></i>
                                <span>@fete.NbInvitesMax invités max</span>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3 px-3">
                        <a asp-action="Details" asp-route-id="@fete.IdFete" class="btn btn-primary w-100">
                            <i class="fas fa-eye me-2"></i>Voir les détails
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
