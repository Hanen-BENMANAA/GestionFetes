@model IEnumerable<Fete>
@{
    ViewData["Title"] = "Les Fêtes Disponibles";
    var upcomingCount = Model.Count(f => f.DateFete > DateTime.Now);
}

<!-- Festive Hero Banner -->
<div class="rounded-4 mb-4 p-4 text-white position-relative overflow-hidden"
     style="background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 40%, #1e40af 70%, #1d4ed8 100%);
            background-size: 300% 300%;
            animation: gradient-shift 8s ease infinite;
            box-shadow: 0 10px 40px rgba(37,99,235,0.35);
            border: 1px solid rgba(253,211,77,0.15);">
    <div class="position-absolute top-0 end-0 p-4 opacity-10" style="font-size:6rem;line-height:1;pointer-events:none;">
        <i class="fas fa-champagne-glasses"></i>
    </div>
    <div class="row align-items-center">
        <div class="col-md-7">
            <div class="d-flex align-items-center gap-3 mb-1">
                <div class="rounded-3 d-flex align-items-center justify-content-center"
                     style="width:52px;height:52px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.2);">
                    <i class="fas fa-champagne-glasses fs-4" style="color:#fcd34d;"></i>
                </div>
                <div>
                    <h2 class="fw-bold mb-0" style="letter-spacing:-0.5px;">Fêtes Disponibles</h2>
                    <p class="mb-0 opacity-75 small">Découvrez et confirmez vos invitations</p>
                </div>
            </div>
        </div>
        <div class="col-md-5 mt-3 mt-md-0 d-flex gap-3 justify-content-md-end align-items-center flex-wrap">
            <div class="text-center">
                <div class="fw-bold fs-4" style="color:#fcd34d;">@Model.Count()</div>
                <div class="opacity-75 small">Total</div>
            </div>
            <div class="opacity-25" style="width:1px;height:40px;background:white;"></div>
            <div class="text-center">
                <div class="fw-bold fs-4" style="color:#6ee7b7;">@upcomingCount</div>
                <div class="opacity-75 small">À venir</div>
            </div>
            <a asp-action="Search" class="btn btn-sm fw-semibold ms-1"
               style="background:rgba(253,211,77,0.9);border:none;border-radius:10px;padding:8px 16px;color:#1f2937;box-shadow:0 4px 15px rgba(253,211,77,0.3);">
                <i class="fas fa-magnifying-glass me-1"></i>Rechercher
            </a>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                 style="width:80px;height:80px;background:rgba(37,99,235,0.08);">
                <i class="fas fa-calendar-times text-primary fs-2"></i>
            </div>
            <h4 class="text-muted fw-semibold">Aucune fête disponible</h4>
            <p class="text-muted small mb-0">Les prochains événements apparaîtront ici</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var fete in Model)
        {
            var badgeClass = fete.Type switch {
                TypeFete.Anniversaire => "badge-anniversaire",
                TypeFete.Mariage => "badge-mariage",
                _ => "badge-autre"
            };
            var icon = fete.Type switch {
                TypeFete.Anniversaire => "fa-birthday-cake",
                TypeFete.Mariage => "fa-ring",
                _ => "fa-star"
            };
            var cardColor = fete.Type switch {
                TypeFete.Anniversaire => "card-anniversaire",
                TypeFete.Mariage => "card-mariage",
                _ => "card-autre"
            };
            var isPast = fete.DateFete < DateTime.Now;
            var isSoon = !isPast && fete.DateFete <= DateTime.Now.AddDays(7);
            var fillPct = fete.NbInvitesMax > 0 ? (int)((double)fete.NbInvitesConfirmes / fete.NbInvitesMax * 100) : 0;

            <div class="col-lg-4 col-md-6">
                <div class="card fete-card h-100 shadow-sm border-0 @cardColor @(isPast ? "opacity-75" : "")">
                    <div class="card-header-custom d-flex justify-content-between align-items-center p-3">
                        <span class="badge @badgeClass fs-6 px-3 py-2">
                            <i class="fas @icon me-1"></i>@fete.Type
                        </span>
                        @if (isPast)
                        {
                            <span class="badge bg-secondary bg-opacity-75 small">Passée</span>
                        }
                        else if (isSoon)
                        {
                            <span class="badge badge-upcoming small">
                                <i class="fas fa-fire me-1"></i>Bientôt !
                            </span>
                        }
                        else
                        {
                            <span class="badge small" style="background:rgba(16,185,129,0.12);color:#065f46;border:1px solid rgba(16,185,129,0.2);">
                                <i class="fas fa-circle-check me-1"></i>À venir
                            </span>
                        }
                    </div>

                    <div class="card-body px-3 pb-2 pt-3">
                        <h5 class="card-title fw-bold mb-3" style="font-size:1rem;line-height:1.4;">@fete.Description</h5>

                        <div class="d-flex flex-column gap-2">
                            <div class="detail-item">
                                <div class="me-2 rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:28px;height:28px;background:rgba(37,99,235,0.1);">
                                    <i class="fas fa-calendar-alt text-primary" style="font-size:0.75rem;"></i>
                                </div>
                                @fete.DateFete.ToString("dddd dd MMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
                            </div>
                            <div class="detail-item">
                                <div class="me-2 rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:28px;height:28px;background:rgba(16,185,129,0.1);">
                                    <i class="fas fa-clock text-success" style="font-size:0.75rem;"></i>
                                </div>
                                @fete.DateFete.ToString("HH:mm") &nbsp;·&nbsp; @fete.Duree h
                            </div>
                            <div class="detail-item">
                                <div class="me-2 rounded-2 d-flex align-items-center justify-content-center flex-shrink-0"
                                     style="width:28px;height:28px;background:rgba(6,182,212,0.1);">
                                    <i class="fas fa-building text-info" style="font-size:0.75rem;"></i>
                                </div>
                                @(fete.Salle?.NomSalle ?? "N/A")
                            </div>
                        </div>

                        <div class="mt-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="small text-muted">Invités confirmés</span>
                                <span class="small fw-semibold">@fete.NbInvitesConfirmes <span class="text-muted fw-normal">/ @fete.NbInvitesMax</span></span>
                            </div>
                            <div class="progress" style="height:5px;border-radius:4px;background:rgba(0,0,0,0.07);">
                                <div class="progress-bar" style="width:@fillPct%;border-radius:4px;background:linear-gradient(90deg,#2563eb,#10b981);"></div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent border-0 pb-3 px-3 pt-2">
                        <a asp-action="Details" asp-route-id="@fete.IdFete" class="btn btn-primary w-100">
                            <i class="fas fa-eye me-2"></i>Voir les détails
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
