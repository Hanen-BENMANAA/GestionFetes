@model FeteSearchViewModel
@{
    ViewData["Title"] = "Rechercher une fête";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="fas fa-search me-2 text-primary"></i>Rechercher une Fête</h2>
    <p class="text-muted">Filtrez les fêtes selon vos critères</p>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <form asp-action="Search" method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-semibold"><i class="fas fa-font me-1"></i>Libellé / Description</label>
                <input type="text" name="libelle" value="@Model.Libelle" class="form-control" placeholder="Rechercher par description..." />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold"><i class="fas fa-tag me-1"></i>Type</label>
                <select name="type" class="form-select">
                    <option value="">Tous les types</option>
                    @foreach (var t in Enum.GetValues<TypeFete>())
                    {
                        <option value="@t" selected="@(Model.Type == t ? "selected" : null)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>Date début</label>
                <input type="date" name="dateDebut" value="@Model.DateDebut?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold"><i class="fas fa-calendar me-1"></i>Date fin</label>
                <input type="date" name="dateFin" value="@Model.DateFin?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="fas fa-search me-1"></i>Rechercher
                </button>
                <a asp-action="Search" class="btn btn-outline-secondary">
                    <i class="fas fa-times"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model.Resultats.Any())
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="text-muted mb-0">@Model.Resultats.Count() résultat(s) trouvé(s)</h5>
    </div>
    <div class="row g-3">
        @foreach (var fete in Model.Resultats)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card fete-card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-primary">@fete.Type</span>
                            <small class="text-muted">@fete.DateFete.ToString("dd/MM/yyyy")</small>
                        </div>
                        <h5 class="fw-bold">@fete.Description</h5>
                        <p class="text-muted small">
                            <i class="fas fa-building me-1"></i>@(fete.Salle?.NomSalle ?? "N/A")<br />
                            <i class="fas fa-users me-1"></i>@fete.NbInvitesMax invités max |
                            <i class="fas fa-clock me-1"></i>@fete.Duree h
                        </p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@fete.IdFete" class="btn btn-sm btn-outline-primary w-100">
                            <i class="fas fa-eye me-1"></i>Détails
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (Context.Request.QueryString.HasValue)
{
    

<div class="text-center py-5">
        <i class="fas fa-search text-muted" style="font-size: 3rem;"></i>
        <h5 class="mt-3 text-muted">Aucune fête ne correspond à votre recherche</h5>
        <a asp-action="Search" class="btn btn-outline-primary mt-2">Réinitialiser</a>
    </div>
}
}